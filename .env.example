# Server-only. Never prefix with NEXT_PUBLIC_.
# AI interpretations use the Anthropic API. Leave empty to run without AI (curated meanings still work).
ANTHROPIC_API_KEY=

# Optional: override the model (default claude-opus-5-5).
# INTERPRETATION_MODEL=claude-opus-5-5

# Optional: "mock" uses a deterministic offline provider (development and end-to-end tests only).
# INTERPRETATION_PROVIDER=mock
